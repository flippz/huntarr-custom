FROM python:3.11-slim

WORKDIR /app

# Install Python dependencies first (better layer caching)
COPY managearr/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only the managearr application source - never the v1 tree.
# Includes tools/ (one-time SQLite -> PostgreSQL importer, run as a
# one-shot Compose command - see compose.managearr.yml).
COPY managearr/ .

EXPOSE 9706

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9706/health', timeout=3)"]

CMD ["waitress-serve", "--host=0.0.0.0", "--port=9706", "run:app"]
