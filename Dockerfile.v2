FROM python:3.11-slim

WORKDIR /app

# Install Python dependencies first (better layer caching)
COPY v2/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only the v2 application source - never the v1 tree
COPY v2/ .

# Persistent data directory for the v2 SQLite database (distinct from v1's ./data)
RUN mkdir -p /data-v2
ENV HUNTARR_V2_DB_PATH=/data-v2/huntarr_v2.db

EXPOSE 9706

CMD ["python", "run.py"]
